# Database connection string (Ví dụ kết nối MySQL)
DATABASE_URL=mysql+pymysql://root:@localhost/web_linh_kien

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# SePay Payment API Key
SEPAY_API_KEY=your_sepay_api_key_here

# SMTP Email Configuration (Ví dụ sử dụng Gmail App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_here@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME="Vua Linh Kiện"

# Cấu hình tài khoản ngân hàng nhận tiền cọc thanh toán (VietQR)
BANK_BIN=MBBank
BANK_ACCOUNT=0799412960
BANK_ACCOUNT_NAME="Vua Linh Kiện"

# Khóa bí mật ký mã hóa JWT (Nên sinh chuỗi hex ngẫu nhiên 32 bytes)
JWT_SECRET_KEY=your_jwt_secret_key_here
